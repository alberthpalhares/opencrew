# Instagram Publisher
# Instagram Graph API — https://developers.facebook.com/docs/instagram-api/
# Requires an Instagram Business account connected to a Facebook Page.
# Get your token from: Meta for Developers → Graph API Explorer
# Required scope: instagram_content_publish
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
IMGBB_API_KEY=

# Image AI Generator (OpenRouter)
OPENROUTER_API_KEY=

# Apify Web Scraper
APIFY_TOKEN=

# Blotato Social Publishing
BLOTATO_API_KEY=

# Canva (uses OAuth — no API key needed, configure via MCP)
# CANVA uses OAuth authentication through the MCP server

# Resend Email
RESEND_API_KEY=
