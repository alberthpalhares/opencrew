{
  "name": "@aksp/opencrew",
  "version": "1.2.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "A reworked build of OpenSquad (by Renato Asse) — create AI agent crews that work together, right from your IDE. Multi-agent orchestration with an npm installer.",
  "type": "module",
  "bin": {
    "opencrew": "bin/opencrew.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/opencrew.js",
    "test": "node --test tests/cli.test.js tests/docs.test.js tests/fsx.test.js tests/ides.test.js tests/init.test.js tests/paths.test.js tests/ui.test.js tests/update.test.js",
    "lint": "eslint src/ tests/ scripts/",
    "version": "node scripts/stamp-version.js && git add templates/_opencrew/.opencrew-version"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "orchestration",
    "crews",
    "claude-code",
    "cursor",
    "codex",
    "gemini",
    "opencode",
    "cli"
  ],
  "author": {
    "name": "aksp",
    "url": "https://www.npmjs.com/~aksp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alberthpalhares/opencrew.git"
  },
  "homepage": "https://github.com/alberthpalhares/opencrew#readme",
  "bugs": {
    "url": "https://github.com/alberthpalhares/opencrew/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@inquirer/checkbox": "^5.1.0",
    "@inquirer/confirm": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.9.0"
  }
}
